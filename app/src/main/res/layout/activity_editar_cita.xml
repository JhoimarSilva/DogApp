<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF1F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Título y encabezado -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/rounded_top_black">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/regresar_content"
                android:importantForAccessibility="yes" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/titulo_editar_cita"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:importantForAccessibility="yes"/>
        </RelativeLayout>

        <!-- Campo: Nombre de la mascota -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nombre_mascota"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#9C27B0"
            android:layout_marginTop="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombreMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_background"
                android:textColorHint="#666666"
                android:importantForAccessibility="yes"
                android:autofillHints="username"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo: Raza -->
        <AutoCompleteTextView
            android:id="@+id/etRaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_raza"
            android:background="@drawable/edittext_background"
            android:padding="12dp"
            android:inputType="text"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:autofillHints="text" />

        <TextView
            android:id="@+id/tvEstadoRaza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccione una raza válida del autocompletado"
            android:textColor="@android:color/holo_red_dark"
            android:visibility="gone"
            android:layout_marginTop="4dp"/>

        <!-- Campo: Nombre del propietario -->
        <EditText
            android:id="@+id/etPropietario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_propietario"
            android:background="@drawable/edittext_background"
            android:padding="12dp"
            android:inputType="text"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:autofillHints="name" />

        <!-- Campo: Teléfono -->
        <EditText
            android:id="@+id/etTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_telefono"
            android:background="@drawable/edittext_background"
            android:padding="12dp"
            android:inputType="phone"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:autofillHints="phone" />

        <!-- Botón Guardar Cita -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_guardar"
            android:drawableStart="@drawable/ic_save"
            android:backgroundTint="#EF5350"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="64dp"
            android:drawablePadding="8dp"
            android:layout_marginTop="32dp"
            android:layout_gravity="center"
            android:enabled="false"/>
    </LinearLayout>
</ScrollView>